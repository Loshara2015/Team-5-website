<!DOCTYPE html>
<html lang="uk">
<head>
    <%- include('partials/head', { title: category.name + ' - Помпі' }) %>
</head>
<body>
    <%- include('partials/header') %>

    <main class="catalog-main">
        <div class="catalog-wrapper">
            <a href="/catalog" class="back-link">
                <i class="fas fa-arrow-left"></i> Назад до категорій
            </a>
            
            <h1 class="category-title">
                <%= category.name %>
            </h1>
            
            <% if (subcategories && subcategories.length > 0) { %>
                <div class="subcategory-section">
                    <h2 class="subcategory-title">Підкатегорії:</h2>
                    <div class="subcategory-grid">
                        <% subcategories.forEach(function(sub) { %>
                            <a href="/catalog/<%= sub.id %>" class="subcategory-card">
                                <i class="fas fa-folder-open"></i>
                                <%= sub.name %>
                            </a>
                        <% }); %>
                    </div>
                </div>
            <% } %>
            
            <div class="products-grid">
                <% if (products && products.length > 0) { %>
                    <% products.forEach(function(product) { %>
                        <div class="product-card">
                            <% const productImage = String(product.image || '').trim(); %>
                            <div class="product-image <%= productImage ? '' : 'product-image--missing' %>">
                                <% if (productImage) { %>
                                    <img 
                                        src="<%= productImage %>" 
                                        alt="" 
                                        loading="lazy"
                                        onerror="this.onerror=null; this.style.display='none'; this.parentElement.classList.add('product-image--missing');"
                                    >
                                <% } %>
                            </div>
                            <div class="product-info">
                                <h3 class="product-title"><%= product.name %></h3>
                                <p class="product-desc"><%= product.description %></p>
                                <div class="product-price">
                                    <%= new Intl.NumberFormat('uk-UA', { style: 'currency', currency: 'UAH', maximumFractionDigits: 0 }).format(product.price) %>
                                </div>
                                <button class="buy-btn" data-name="<%= product.name %>" data-price="<%= product.price %>">Купити</button>
                            </div>
                        </div>
                    <% }); %>
                <% } else if (!subcategories || subcategories.length === 0) { %>
                    <p style="text-align: center; color: #666;">Ця категорія поки порожня.</p>
                <% } %>
            </div>
        </div>
    </main>

    <%- include('partials/auth-forms') %>
    <%- include('partials/footer') %>
</body>
</html>