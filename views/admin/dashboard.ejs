<!DOCTYPE html>
<html lang="uk">
<head>
    <%- include('../partials/head', { title: 'Адмін-панель' }) %>
</head>
<body>
    <%- include('../partials/header') %>
    <main class="catalog-main">
        <div class="catalog-wrapper">
            <h1>Управління товарами</h1>
            
            <section style="margin-bottom: 40px; padding: 20px; border: 1px solid #eee;">
                <h3>Додати новий товар</h3>
                <form action="/catalog/admin/products/add" method="POST">
                    <input type="text" name="name" placeholder="Назва товару" required style="width:100%; margin-bottom:10px;">
                    <textarea name="description" placeholder="Опис" required style="width:100%; margin-bottom:10px;"></textarea>
                    <input type="number" name="price" placeholder="Ціна" required style="width:100%; margin-bottom:10px;">
                    <input type="text" name="image" placeholder="URL картинки" required style="width:100%; margin-bottom:10px;">
                    <select name="categoryId" required style="width:100%; margin-bottom:10px; padding: 8px;">
                        <option value="" disabled selected>Оберіть категорію товару...</option>
                        
                        <% categories.filter(c => c.parentId === null).forEach(root => { %>
                            <optgroup label="<%= root.name %>">
            
                            <% categories.filter(sub => sub.parentId === root.id).forEach(sub => { %>
                                <% const hasChildren = categories.some(c => c.parentId === sub.id); %>
                
                                <% if (hasChildren) { %>
                                    <option disabled>— <%= sub.name %></option>
                    
                                    <% categories.filter(leaf => leaf.parentId === sub.id).forEach(leaf => { %>
                                         <option value="<%= leaf.id %>">&nbsp;&nbsp;&nbsp;&nbsp;• <%= leaf.name %></option>
                                    <% }) %>
                                <% } else { %>
                                    <option value="<%= sub.id %>">— <%= sub.name %></option>
                                <% } %>
                            <% }) %>
            
                        </optgroup>
                    <% }) %>
                </select>
                    <button type="submit" class="buy-btn">Створити товар</button>
                </form>
            </section>
            <table style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="background: #f4f4f4;">
                        <th style="padding: 10px; border: 1px solid #ddd;">ID</th>
                        <th style="padding: 10px; border: 1px solid #ddd;">Назва</th>
                        <th style="padding: 10px; border: 1px solid #ddd;">Дія</th>
                    </tr>
                </thead>
                <tbody>
                    <% products.forEach(prod => { %>
                        <tr>
                            <td style="padding: 10px; border: 1px solid #ddd;"><%= prod.id %></td>
                            <td style="padding: 10px; border: 1px solid #ddd;"><%= prod.name %></td>
                            <td style="padding: 10px; border: 1px solid #ddd;">
                                <a href="/catalog/admin/products/edit/<%= prod.id %>" style="color: blue; margin-right: 15px; text-decoration: none; font-weight: bold;">Редагувати</a>
                                <form action="/catalog/admin/products/delete/<%= prod.id %>" method="POST" style="display:inline;">
                                    <button type="submit" style="color: red; border:none; background:none; cursor:pointer;">Видалити</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <hr style="margin: 50px 0 30px 0; border: 1px solid #ddd;">
            <h1 style="margin-bottom: 20px;">Управління категоріями</h1>
            
            <section style="margin-bottom: 40px; padding: 20px; border: 1px solid #eee; background: #fafafa;">
                <h3>Додати нову категорію</h3>
                <form action="/catalog/admin/categories/add" method="POST" style="margin-top: 15px;">
                    <div style="margin-bottom: 15px;">
                        <input type="text" name="name" placeholder="Назва категорії (напр. Ігрові приставки)" required style="width:100%; padding: 8px;">
                    </div>
                    
                    <div style="margin-bottom: 15px;">
                        <label style="display: block; margin-bottom: 5px; color: #555;">Батьківська категорія (залиште порожнім, якщо це головна категорія):</label>
                        <select name="parentId" style="width:100%; padding: 8px;">
                            <option value="">-- Немає (Зробити головною категорією) --</option>
                            <% categories.forEach(cat => { %>
                                <option value="<%= cat.id %>"><%= cat.name %></option>
                            <% }) %>
                        </select>
                    </div>
                    
                    <button type="submit" class="buy-btn">Створити категорію</button>
                </form>
            </section>

            <table style="width: 100%; border-collapse: collapse; margin-bottom: 40px;">
                <thead>
                    <tr style="background: #f4f4f4;">
                        <th style="padding: 10px; border: 1px solid #ddd; text-align: left;">ID</th>
                        <th style="padding: 10px; border: 1px solid #ddd; text-align: left;">Назва</th>
                        <th style="padding: 10px; border: 1px solid #ddd; text-align: left;">Батьківський ID</th>
                        <th style="padding: 10px; border: 1px solid #ddd; text-align: left;">Дія</th>
                    </tr>
                </thead>
                <tbody>
                    <% categories.forEach(cat => { %>
                        <tr>
                            <td style="padding: 10px; border: 1px solid #ddd;"><%= cat.id %></td>
                            <td style="padding: 10px; border: 1px solid #ddd;">
                                <strong><%= cat.name %></strong>
                            </td>
                            <td style="padding: 10px; border: 1px solid #ddd; color: #666;">
                                <%= cat.parentId ? cat.parentId : '— (Головна)' %>
                            </td>
                            <td style="padding: 10px; border: 1px solid #ddd;">
                                <a href="/catalog/admin/categories/edit/<%= cat.id %>" style="color: blue; margin-right: 15px; text-decoration: none; font-weight: bold;">Редагувати</a>
                                <form action="/catalog/admin/categories/delete/<%= cat.id %>" method="POST" style="display:inline;">
                                <button type="submit" style="color: red; border:none; background:none; cursor:pointer; font-weight: bold;" onclick="return confirm('Ви впевнені? Це також може зламати товари, які прив\'язані до цієї категорії!')">Видалити</button>
                            </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
            
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>