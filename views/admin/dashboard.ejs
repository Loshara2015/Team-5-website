<!DOCTYPE html>
<html lang="uk">
<head>
    <%- include('../partials/head', { title: 'Адмін-панель' }) %>
</head>
<body>
    <%- include('../partials/header') %>
    <main class="catalog-main">
        <div class="catalog-wrapper">

            <% if (message) { %>
                <div class="admin-message <%= status === 'success' ? 'admin-message--success' : 'admin-message--error' %>">
                    <%= message %>
                </div>
            <% } %>        

            <h1>Управління товарами</h1>
            
            <section class="admin-section">
                <h3>Додати новий товар</h3>
                <form action="/catalog/admin/products/add" method="POST">
                    <input type="text" name="name" placeholder="Назва товару" required class="admin-input">
                    <textarea name="description" placeholder="Опис" required class="admin-textarea"></textarea>
                    <input type="number" name="price" placeholder="Ціна" required class="admin-input">
                    <input type="text" name="image" placeholder="URL картинки" required class="admin-input">
                    
                    <select name="categoryId" class="admin-form-select" required>
                        <option value="" disabled selected>Оберіть категорію товару...</option>
                        
                        <% categories.filter(c => c.parentId === null).forEach(root => { %>
                            <option value="<%= root.id %>" class="opt-root">
                                📁 <%= root.name %>
                            </option>
                            
                            <% categories.filter(sub => sub.parentId === root.id).forEach(sub => { %>
                                <option value="<%= sub.id %>" class="opt-sub-1">
                                    &nbsp;&nbsp;&nbsp;&nbsp;— <%= sub.name %>
                                </option>
                                
                                <% categories.filter(leaf => leaf.parentId === sub.id).forEach(leaf => { %>
                                    <option value="<%= leaf.id %>" class="opt-sub-2">
                                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;• <%= leaf.name %>
                                    </option>
                                <% }) %>
                            <% }) %>
                        <% }) %>
                    </select>
                    
                    <button type="submit" class="buy-btn">Створити товар</button>
                </form>
            </section>
            
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Назва</th>
                        <th>Дія</th>
                    </tr>
                </thead>
                <tbody>
                    <% products.forEach(prod => { %>
                        <tr>
                            <td><%= prod.id %></td>
                            <td><%= prod.name %></td>
                            <td>
                                <a href="/catalog/admin/products/edit/<%= prod.id %>" class="admin-action-edit">Редагувати</a>
                                <form action="/catalog/admin/products/delete/<%= prod.id %>" method="POST" class="admin-action-form">
                                    <button type="submit" class="admin-action-delete">Видалити</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <hr class="admin-divider">
            <h1 class="admin-page-title">Управління категоріями</h1>
            
            <section class="admin-section admin-section-light">
                <h3>Додати нову категорію</h3>
                <form action="/catalog/admin/categories/add" method="POST" class="admin-form">
                    <div class="admin-form-group">
                        <input type="text" name="name" placeholder="Назва категорії (напр. Ігрові приставки)" required class="admin-input">
                    </div>
                    
                    <div class="admin-form-group">
                        <label class="admin-label">Батьківська категорія (залиште порожнім, якщо це головна категорія):</label>
                        <select name="parentId" class="admin-form-select">
                            <option value="">-- Без батьківської категорії (Зробити головною) --</option>
                            
                            <% categories.filter(c => c.parentId === null).forEach(root => { %>
                                <option value="<%= root.id %>" class="opt-root">
                                    📁 <%= root.name %>
                                </option>
                                
                                <% categories.filter(sub => sub.parentId === root.id).forEach(sub => { %>
                                    <option value="<%= sub.id %>" class="opt-sub-1">
                                        &nbsp;&nbsp;&nbsp;&nbsp;— <%= sub.name %>
                                    </option>
                                    
                                    <% categories.filter(leaf => leaf.parentId === sub.id).forEach(leaf => { %>
                                        <option value="<%= leaf.id %>" class="opt-sub-2">
                                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;• <%= leaf.name %>
                                        </option>
                                    <% }) %>
                                <% }) %>
                            <% }) %>
                        </select>
                    </div>
                    
                    <button type="submit" class="buy-btn">Створити категорію</button>
                </form>
            </section>

            <section class="admin-section admin-section-blueish">
                <h3>Демонстрація транзакції: категорія + товар</h3>
                <p class="admin-description">
                    Ця операція в одній транзакції спочатку створює категорію, а потім товар у ній.
                    Якщо ввімкнути генерацію помилки, вставка товару зламається через обмеження ціни,
                    і PostgreSQL відкотить усю операцію.
                </p>

                <form action="/catalog/admin/demo/category-with-product" method="POST" class="admin-form">
                    <input type="text" name="categoryName" placeholder="Назва нової категорії" required class="admin-input">
                    
                    <select name="parentId" class="admin-form-select">
                        <option value="">-- Без батьківської категорії (Зробити головною) --</option>
                        
                        <% categories.filter(c => c.parentId === null).forEach(root => { %>
                            <option value="<%= root.id %>" class="opt-root">
                                📁 <%= root.name %>
                            </option>
                            
                            <% categories.filter(sub => sub.parentId === root.id).forEach(sub => { %>
                                <option value="<%= sub.id %>" class="opt-sub-1">
                                    &nbsp;&nbsp;&nbsp;&nbsp;— <%= sub.name %>
                                </option>
                                
                                <% categories.filter(leaf => leaf.parentId === sub.id).forEach(leaf => { %>
                                    <option value="<%= leaf.id %>" class="opt-sub-2">
                                        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;• <%= leaf.name %>
                                    </option>
                                <% }) %>
                            <% }) %>
                        <% }) %>
                    </select>

                    <input type="text" name="productName" placeholder="Назва товару" required class="admin-input">
                    <textarea name="productDescription" placeholder="Опис товару" required class="admin-textarea"></textarea>
                    <input type="number" name="productPrice" step="0.01" min="0" placeholder="Ціна товару" required class="admin-input">
                    <input type="text" name="productImage" placeholder="URL картинки товару" required class="admin-input">

                    <label class="admin-checkbox-label">
                        <input type="checkbox" name="simulateError" value="true">
                        Згенерувати помилку та перевірити ROLLBACK
                    </label>

                    <button type="submit" class="buy-btn">Виконати бізнес-операцію</button>
                </form>
            </section>

            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Назва</th>
                        <th>Батьківський ID</th>
                        <th>Дія</th>
                    </tr>
                </thead>
                <tbody>
                    <% categories.forEach(cat => { %>
                        <tr>
                            <td><%= cat.id %></td>
                            <td>
                                <strong><%= cat.name %></strong>
                            </td>
                            <td class="admin-text-muted">
                                <%= cat.parentId ? cat.parentId : '— (Головна)' %>
                            </td>
                            <td>
                                <a href="/catalog/admin/categories/edit/<%= cat.id %>" class="admin-action-edit">Редагувати</a>
                                <form action="/catalog/admin/categories/delete/<%= cat.id %>" method="POST" class="admin-action-form">
                                    <button type="submit" class="admin-action-delete bold" onclick="return confirm('Ви впевнені? Це також може зламати товари, які прив\'язані до цієї категорії!')">Видалити</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
            
        </div>
    </main>
    <%- include('../partials/footer') %>
</body>
</html>