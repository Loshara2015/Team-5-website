<!DOCTYPE html>
<html lang="uk">
<head>
    <%- include('partials/head', { title: 'Каталог товарів - Помпі' }) %>
</head>
<body>
    <%- include('partials/header') %>

    <main class="catalog-main">
        <div class="catalog-wrapper">
            <h1 class="catalog-title">Каталог товарів</h1>
            
            <ul class="category-list">
                <% if (categories && categories.length > 0) { %>
                    <% categories.forEach(function(category) { %>
                        <li class="category-item">
                            <a href="/catalog/<%= category.id %>" class="category-link">
                                <i class="fas fa-folder"></i>
                                <%= category.name %>
                            </a>
                        </li>
                    <% }); %>
                <% } else { %>
                    <p style="text-align: center;">Категорій поки немає.</p>
                <% } %>
            </ul>
        </div>
    </main>

    <%- include('partials/auth-forms') %>
    <%- include('partials/footer') %>
</body>
</html>